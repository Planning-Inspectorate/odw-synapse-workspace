{
	"name": "DOCUMENT",
	"properties": {
		"activities": [
			{
				"name": "Copy File",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.00:20:00",
					"retry": 3,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "BinarySource",
						"storeSettings": {
							"type": "AzureFileStorageReadSettings",
							"recursive": true,
							"wildcardFolderPath": "ODW/AIE/S62A migrations - extracts/",
							"wildcardFileName": "*.csv",
							"deleteFilesAfterCompletion": false
						},
						"formatSettings": {
							"type": "BinaryReadSettings"
						}
					},
					"sink": {
						"type": "BinarySink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						}
					},
					"enableStaging": false
				},
				"inputs": [
					{
						"referenceName": "S62A",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "S62A_INPUTD",
						"type": "DatasetReference"
					}
				]
			}
		],
		"folder": {
			"name": "S62A"
		},
		"annotations": []
	}
}