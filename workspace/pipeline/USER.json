{
	"name": "USER",
	"properties": {
		"activities": [
			{
				"name": "Copy Entra ID Users",
				"description": "Calls the Entra ID and retrieves a list of the users and their attributes",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.02:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "RestSource",
						"httpRequestTimeout": "00:01:40",
						"requestInterval": "00.00:00:00.010",
						"requestMethod": "GET",
						"paginationRules": {
							"AbsoluteUrl": "$['@odata.nextLink']"
						}
					},
					"sink": {
						"type": "JsonSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "JsonWriteSettings",
							"filePattern": "arrayOfObjects"
						}
					},
					"enableStaging": false
				},
				"inputs": [
					{
						"referenceName": "ds_entra_id1",
						"type": "DatasetReference",
						"parameters": {
							"query": "users?$select=id,givenName,surname,displayName,mail,userPrincipalName,employeeId"
						}
					}
				],
				"outputs": [
					{
						"referenceName": "ds_s62a_entra_users",
						"type": "DatasetReference",
						"parameters": {
							"FileName": "entraid_users.json"
						}
					}
				]
			},
			{
				"name": "Notebook1",
				"type": "SynapseNotebook",
				"dependsOn": [
					{
						"activity": "Copy Entra ID Users",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"notebook": {
						"referenceName": "nb_s62a_users",
						"type": "NotebookReference"
					},
					"snapshot": true
				}
			}
		],
		"folder": {
			"name": "S62A"
		},
		"annotations": []
	}
}