{
	"name": "LOAD Additional Note",
	"properties": {
		"activities": [
			{
				"name": "Additional ApplicationNote",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "Additional_note",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "DelimitedTextSource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true,
							"wildcardFolderPath": "PIPELINE/OUTPUT/ADDITIONAL_NOTES/",
							"wildcardFileName": "ApplicationNote_additional.csv",
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "DelimitedTextReadSettings"
						}
					},
					"sink": {
						"type": "AzureSqlSink",
						"writeBehavior": "upsert",
						"upsertSettings": {
							"useTempDB": true,
							"keys": {
								"value": "@createArray('id')",
								"type": "Expression"
							}
						},
						"sqlWriterUseTableLock": false,
						"disableMetricsCollection": false
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "s62a_schema_csv",
						"type": "DatasetReference",
						"parameters": {
							"fileName": "ApplicationNote_additional.csv"
						}
					}
				],
				"outputs": [
					{
						"referenceName": "S62ADB",
						"type": "DatasetReference",
						"parameters": {
							"tableName": "ApplicationNote"
						}
					}
				]
			},
			{
				"name": "Additional_note",
				"type": "SynapseNotebook",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"notebook": {
						"referenceName": "s62a_additional_notes",
						"type": "NotebookReference"
					},
					"snapshot": true
				}
			}
		],
		"folder": {
			"name": "S62A"
		},
		"annotations": []
	}
}